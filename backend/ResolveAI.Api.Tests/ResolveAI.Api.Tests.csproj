<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.EntityFrameworkCore">
      <HintPath>$(UserProfile)\.nuget\packages\microsoft.entityframeworkcore\10.0.12\lib\net10.0\Microsoft.EntityFrameworkCore.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.EntityFrameworkCore.Relational">
      <HintPath>$(UserProfile)\.nuget\packages\microsoft.entityframeworkcore.relational\10.0.12\lib\net10.0\Microsoft.EntityFrameworkCore.Relational.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.EntityFrameworkCore.Abstractions">
      <HintPath>$(UserProfile)\.nuget\packages\microsoft.entityframeworkcore.abstractions\10.0.12\lib\net10.0\Microsoft.EntityFrameworkCore.Abstractions.dll</HintPath>
    </Reference>
    <Reference Include="Npgsql">
      <HintPath>..\ResolveAI.Api\bin\Release\net10.0\Npgsql.dll</HintPath>
    </Reference>
    <Reference Include="Npgsql.EntityFrameworkCore.PostgreSQL">
      <HintPath>$(UserProfile)\.nuget\packages\npgsql.entityframeworkcore.postgresql\10.0.3\lib\net10.0\Npgsql.EntityFrameworkCore.PostgreSQL.dll</HintPath>
    </Reference>
    <Reference Include="ResolveAI.Api">
      <HintPath>..\ResolveAI.Api\bin\Release\net10.0\ResolveAI.Api.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ResolveAI.Api\bin\Release\net10.0\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="VSTest">
    <Exec Command="dotnet $(TargetPath)" />
  </Target>

  <Target Name="Test">
    <Exec Command="dotnet $(TargetPath)" />
  </Target>

</Project>